generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int      @id @default(autoincrement())
  telegramId        String   @unique
  username          String?
  firstName         String?
  lastName          String?
  photoUrl          String?
  
  // Подписка
  subscriptionUntil DateTime?
  
  // Реферальная система
  referralCode      String   @unique
  invitedBy         Int? // telegramId пригласившего (пока не используем)
  referralBonus     Int      @default(0)
  
  // Связи
  // Пользователи, которых пригласил этот пользователь
  invitedUsers      InvitedUser[] @relation("Referrer")
  
  // Пользователь, который пригласил этого пользователя
  invitedByUser     InvitedUser?  @relation("Invited")
  
  purchases         Purchase[]
  activationCodes   ActivationCode[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model InvitedUser {
  id            Int      @id @default(autoincrement())
  referrerId    String   // telegramId пользователя, который пригласил
  invitedUserId String   @unique // telegramId приглашенного
  
  // Связи
  referrer      User     @relation("Referrer", fields: [referrerId], references: [telegramId])
  invitedUser   User     @relation("Invited", fields: [invitedUserId], references: [telegramId])
  
  status        String   @default("pending") // pending, activated
  bonusGiven    Boolean  @default(false)
  invitedAt     DateTime @default(now())
  activatedAt   DateTime?
}

model Purchase {
  id            Int      @id @default(autoincrement())
  userId        String
  user          User     @relation(fields: [userId], references: [telegramId])
  plan          String   // month, 3months, 6months, year
  stars         Int
  status        String   @default("active") // active, expired
  expiresAt     DateTime
  purchasedAt   DateTime @default(now())
}

model ActivationCode {
  id            Int      @id @default(autoincrement())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [telegramId])
  code          String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}